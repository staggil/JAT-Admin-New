                    <Style>
                      <FontSize>8pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Sum(Fields!memberFee.Value) + Sum(Fields!vat.Value)  + Sum(Fields!newsFee.Value)</Value>
