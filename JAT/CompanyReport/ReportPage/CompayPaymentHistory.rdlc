            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Member fee = </Value>
                    <Style>
                      <FontSize>8pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Round((Sum(Round(Fields!memberFee.Value,3)) + Sum(Round(Fields!vat.Value,3))) / 1.07,2)</Value>
