                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox4">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Fields!companyNm.Value &amp; VbCrLf &amp; IIF(Fields!sendType.Value="$",Fields!homeAddress.Value,IIF(Fields!sendType.Value="#",Fields!companyAddress.Value,""))</Value>
                                      <Style />
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox4</rd:DefaultName>
                              <Top>1.36359cm</Top>
                              <Left>3.96974cm</Left>
                              <Height>1.65307cm</Height>
                              <Width>7.14928cm</Width>
                              <ZIndex>3</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox5">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="賛助会員費/個人会費銀行引落しについて"</Value>
                                      <Style>
                                        <FontFamily>MS Gothic</FontFamily>
                                        <FontSize>14pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox5</rd:DefaultName>
                              <Top>6.24111cm</Top>
                              <Left>1.24583cm</Left>
                              <Height>0.6cm</Height>
                              <Width>18.18123cm</Width>
                              <ZIndex>4</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox6">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="毎度格別のお引き立てを賜り厚くお礼申し上げます。"</Value>
                                      <Style>
                                        <FontFamily>MS Gothic</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox6</rd:DefaultName>
                              <Top>7.69409cm</Top>
                              <Left>1.24583cm</Left>
                              <Height>0.6cm</Height>
                              <Width>18.18123cm</Width>
                              <ZIndex>5</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox7">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="さて、さっそくですが貴殿の会費につきましては銀行より自動引落しの手続きをお願い致しておりますが、預金残高不足により下記分が未だ振り込まれていません。 "</Value>
                                      <Style>
                                        <FontFamily>MS Gothic</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox7</rd:DefaultName>
                              <Top>8.81273cm</Top>
                              <Left>1.24583cm</Left>
                              <Height>0.6cm</Height>
                              <Width>18.18123cm</Width>
                              <ZIndex>6</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox8">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(Fields!datestart.Value &amp; Fields!dateend.Value &lt;&gt; "",Format(CDate(Fields!datestart.Value), "yyyy") &amp; " 年 " &amp; Format(CDate(Fields!datestart.Value), "MM") &amp; " 月  ～ " &amp; Format(CDate(Fields!pDateTo.Value), "yyyy") &amp; " 年 " &amp; Format(CDate(Fields!pDateTo.Value), "MM") &amp; " 月までの " &amp; Fields!accountPeriod.Value &amp; " ヵ月分計 ","計")</Value>
                                      <Style>
                                        <FontFamily>MS Gothic</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox8</rd:DefaultName>
                              <Top>9.67582cm</Top>
                              <Left>1.24583cm</Left>
                              <Height>0.6cm</Height>
                              <Width>9.1098cm</Width>
                              <ZIndex>7</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox9">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="つきましては、誠にお手数ではございますが今一度ご確認の上、下記の要領にてお手配下さる様お願い申し上げます。"</Value>
                                      <Style>
                                        <FontFamily>MS Gothic</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox9</rd:DefaultName>
                              <Top>10.45221cm</Top>
                              <Left>1.24583cm</Left>
                              <Height>0.6cm</Height>
                              <Width>18.18123cm</Width>
                              <ZIndex>8</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox10">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="（　）① 遠方につき、日本人会までこちらより使いの者を出向かせる。いつ頃…___________________________________" &amp; VbCrLf &amp; "（　）② 銀行振込み希望【日本人会の口座に振り込みたい】" &amp; VbCrLf &amp; "口座名義： Japanese Association in Thailand" &amp; VbCrLf &amp; "口座番号： アユタヤ銀行　Bank of Ayudhaya :Bangkok Tonson Branch  789-1-04103-6 (Saving Account)" &amp; VbCrLf &amp; "口座番号： BANGKOK BANK （バンコク銀行） 【Silom本店】 101-7-884188" &amp; VbCrLf &amp; "口座番号： KASIKORN BANK 【Silom支店】 001-2-74616-6"</Value>
                                      <Style>
                                        <FontFamily>MS Gothic</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox10</rd:DefaultName>
                              <Top>16.65291cm</Top>
                              <Left>1.24583cm</Left>
                              <Height>1.36729cm</Height>
                              <Width>18.18123cm</Width>
                              <ZIndex>9</ZIndex>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <Textbox Name="Textbox11">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="＊時間外の場合、食堂会計部に預けていただく方法もございますので予めご相談願います。" &amp; VbCrLf &amp; "＊業務時間…月曜日～金曜日9：00～17：00 ／ 土曜日9：00～12：00（但し、第一土曜日のみ休日）"</Value>
                                      <Style>
                                        <FontFamily>MS Gothic</FontFamily>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
