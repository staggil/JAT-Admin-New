                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="日本人会登録内容及び名簿掲載不可内容のご確認のお願い"</Value>
                                  <Style>
                                    <FontFamily>MS Gothic</FontFamily>
                                  </Style>
