<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="JAT.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%--<title><%: Page.Title %> - My ASP.NET Application</title>--%>
    <title><%: Page.Title %></title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <%--<link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />--%>
    <link href="~/img/jat_icon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- CSS Style -->
    <link href="css/Style.css" rel="stylesheet" />
    <!-- Font Awesome JS -->
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous" />

    <%--****************** Font Janpanenes**********************--%>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300&display=swap" rel="stylesheet">
</head>

<style>
    body {
        font-size: 16px;
        font-family: Rubik, sans-serif,'Noto Serif JP';
    }
     /*update by tim*/
    label{
    margin-left: 5px;
    margin-right: 5px;
    }
</style>

<body>

    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="bootstrap" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>


          <%----------------------------------------------------------------------%>
        <asp:Panel DefaultButton="ButtonPopupConfirm" runat="server" ID="PanelButton">
           <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h6 class="modal-title" id="exampleModalLabel" style="font-size:24px; text-align:center;">Request Password</h6>
                   <%-- <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>--%>
                  </div>
                  <div class="modal-body" style="text-align: center;">
                      <span style="font-size:16px">Password : </span>
                      <asp:TextBox TextMode="Password" ID="TextBoxRequestPassword" ClientIDMode="Static" runat="server"></asp:TextBox>
                      <asp:Label ID="LabelCheckPassword" style="color:red;" runat="server" ClientIDMode="Static" Visible="false" Text="Label">Wrong Password</asp:Label>
                    </div>
                  <div class="modal-footer">
                  
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button> 
                    <asp:Button  ID="ButtonPopupConfirm" ClientIDMode="Static" CssClass="btn btn-primary" UseSubmitBehavior="false" OnClick="ButtonPopupConfirm_Click" runat="server" Text="Confirm" />
                  
                 </div>
                </div>
              </div>
            </div>
            </asp:Panel>
        <%----------------------------------------------------------------------%>
        <!-- Page Content  -->
        <div id="content" style="padding: 0px;">
            <div class="wrapper-header">
                
                <nav class="" id="header">

                    <ul class="nav navbar-top-links pull-right">
                        <li style="float: left;">
                            <asp:LinkButton ID="LinkButtonJP" runat="server" AutoPostBack="true" OnClick="LinkButtonJP_Click">JA</asp:LinkButton>
                             
                        </li>
                        <li style="float: left;">
                            <asp:LinkButton ID="LinkButtonEN" runat="server" AutoPostBack="true" OnClick="LinkButtonEN_Click">EN</asp:LinkButton>
                            
                        </li>
                    </ul>
                </nav>
            </div>
           
            <div class="ContentBox">
                <div class="container body-content" style="width: calc(100% - 10px);">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                    <hr />
                    <footer>
                        <p align="center">JAT In-House System v1.5<br/>Copyright &copy; <%: DateTime.Now.Year %> Japanese Association in Thailand. All Rights Reserved.</p>
                    </footer>
                </div>
            </div>
        </div>

        <div class="wrapper">
            <!-- Sidebar  -->
            <nav id="sidebar" style="overflow: scroll;">
                <%--overlay--%>
                <div class="sidebar-header">
                    
                    <img src="~/img/JAT_LOGO.png" width="40" runat="server" />
                    <a style="color: black; font-size: 24px;"><b>JAT</b></a>
                </div>

