                        <asp:HyperLink ID="HyperLinkPopUp" data-toggle="modal" data-target="#exampleModal" runat="server" ClientIDMode="Static"><i class="fas fa-info-circle faspace"></i><%=Resources.Resources.menu_7_header %></asp:HyperLink>
