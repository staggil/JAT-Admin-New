        private void insertData()
        {
            connection();
            SqlCommand sc;
            SqlDataReader rd;
            string sql = "select top 1 tranId,companyId from CompanyPayment where companyId = '" + showMem + "' order by tranId desc;";
            try
            {
                conn.Open();
                sc = new SqlCommand(sql, conn);
                rd = sc.ExecuteReader();
                while (rd.Read())
                {
                    lbl.Text = rd.GetValue(0).ToString();
                }
                conn.Close();
            }
            catch { }
            if (lbl.Text == "" || lbl.Text == null)
            {
                int tranId = 1;
                cmd = new SqlCommand("INSERT INTO dbo.CompanyPayment VALUES('" + tranId + "','" + showMem + "','" + bNo.Value + "','" + cNo.Value + "','" + paymentDate.Value + "','" + effectiveDate.Value + "','" + noPayMonth.Value + "','" + expiredDate.Value + "',' ','" + payRemark.Text + "','" + checkShort.Value + "','" + memberFee.Value + "','" + newsFee.Value + "','" + totalPerMonth.Value + "','" + totalFee.Value + "',' ','" + payMethod.Text + "',' ',' ')", conn);
                conn.Open();
                int k = cmd.ExecuteNonQuery();
                //if (k != 0)
                //{
                //    Label1.Text = "Record Inserted Succesfully into the Database";
                //}
                conn.Close();
                Response.Redirect("companyPayment.aspx?companyId=" + showMem);
            }
            else if (lbl.Text != "" || lbl.Text != null)
            {
                long val = Int64.Parse(lbl.Text);
                long tranId = ++val;
                //Label1.Text = tranId.ToString();
                cmd = new SqlCommand("INSERT INTO dbo.CompanyPayment VALUES('" + tranId + "','" + showMem + "','" + bNo.Value + "','" + cNo.Value + "','" + paymentDate.Value + "','" + effectiveDate.Value + "','" + noPayMonth.Value + "','" + expiredDate.Value + "',' ','" + payRemark.Text + "','" + checkShort.Value + "','" + memberFee.Value + "','" + newsFee.Value + "','" + totalPerMonth.Value + "','" + totalFee.Value + "',' ','" + payMethod.Text + "',' ',' ')", conn);
                conn.Open();
                int k = cmd.ExecuteNonQuery();
                //if (k != 0)
                //{
                //    Label1.Text = "Record Inserted Succesfully into the Database";
                //}
                conn.Close();
                Response.Redirect("companyPayment.aspx?companyId='" + showMem + "'");
            }
        }

        protected void save_Click(object sender, EventArgs e)
        {
            insertData();

        }
        private void BindCompanyPayment()
        {
            DataGrid1.DataSource = GetStaffData().Tables["CompanyPayment"].DefaultView;
            DataGrid1.DataBind();
            
        }
        private DataSet GetStaffData()
        {
            connection();
            String SQLStatement = "SELECT '"+ PcompanyNmJ.Text + "' as PcompanyNmJ,totalFee,paymentDate,effectiveDate,expiredDate,payMethod,bNo,cNo " +
            "FROM  CompanyPayment WHERE companyId = '"+ showMem + "' order by tranId DESC ";
            SqlDataAdapter dataAdapter = new SqlDataAdapter(SQLStatement, conn);
            DataSet myDataSet;
            dataAdapter.SelectCommand.CommandType = CommandType.Text;
            myDataSet = new DataSet();
            dataAdapter.Fill(myDataSet, "CompanyPayment");
            return myDataSet;
        }

