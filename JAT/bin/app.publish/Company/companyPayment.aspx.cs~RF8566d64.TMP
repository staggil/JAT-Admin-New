        protected void update_Click(object sender, EventArgs e)
        {
            connection();
            //cmd = new SqlCommand("UPDATE CompanyMember SET bNo = '" + bNo.Value + "'," +
            //                    "cNo = '" + cNo.Value + "',paymentDate = '" + paymentDate.Value + "',effectiveDate =  '" + effectiveDate.Value + "'," +
